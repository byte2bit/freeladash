# Optional in local development; required for production (openssl rand -base64 32).
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Google Cloud > OAuth client > Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional. Defaults to ./data/freeladash.sqlite
# DATABASE_PATH=./data/freeladash.sqlite
# Optional: only behind a trusted proxy that overwrites this header with one IP.
# Never trust a client-supplied forwarded header or expose the Node server directly.
# AUTH_RATE_LIMIT_IP_HEADER=x-real-ip
